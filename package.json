{
  "name": "metaproject",
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    "./components": "./components/index.js",
    "./data-source": "./data-source/index.js",
    "./compiler": "./compiler/index.js",
    "./compiler/browser": "./compiler/browser.js",
    "./vite": "./vite/index.js",
    "./openapi": "./openapi/index.js",
    "./project": "./project/index.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "find api components data-source compiler vite operations mock-api openapi project init build bin -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "lit": "3.3.3",
    "yaml": "2.8.1",
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "bin": {
    "metaproject": "./bin/metaproject.js"
  },
  "files": [
    "api/",
    "operations/",
    "bin/",
    "build/",
    "compiler/",
    "components/",
    "data-source/",
    "docs/",
    "init/",
    "mock-api/",
    "openapi/",
    "project/",
    "skills/",
    "vite/",
    "README.md"
  ]
}
