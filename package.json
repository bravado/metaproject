{
  "name": "metaproject",
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    "./components": "./components/index.js",
    "./data-source": "./data-source/index.js",
    "./compiler": "./compiler/index.js",
    "./compiler/browser": "./compiler/browser.js",
    "./vite": "./vite/index.js",
    "./openapi": "./openapi/index.js",
    "./project": "./project/index.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "find api components data-source compiler vite operations mock-api openapi project init build bin -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test:browser": "node tests/browser-e2e.mjs",
    "test:examples": "node tests/examples-ci.mjs"
  },
  "dependencies": {
    "lit": "3.3.3",
    "yaml": "2.8.1",
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "bin": {
    "metaproject": "./bin/metaproject.js"
  },
  "files": [
    "api/",
    "operations/",
    "bin/",
    "build/",
    "compiler/",
    "components/",
    "data-source/",
    "docs/",
    "init/",
    "mock-api/",
    "openapi/",
    "project/",
    "skills/",
    "vite/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "description": "OpenAPI-driven development and build tools for reusable Web Components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bravado/metaproject.git"
  },
  "homepage": "https://github.com/bravado/metaproject#readme",
  "bugs": {
    "url": "https://github.com/bravado/metaproject/issues"
  },
  "keywords": [
    "openapi",
    "web-components",
    "custom-elements",
    "api",
    "compiler",
    "static-build",
    "lit"
  ]
}
